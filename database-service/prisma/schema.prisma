generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AdmissionStatus {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED

  @@map("admission_status")
}

model AdmissionClass {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique @db.VarChar(100)
  totalSeats Int      @map("total_seats")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  holds AdmissionHold[]

  @@map("admission_classes")
}

model AdmissionHold {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String          @map("class_id") @db.Uuid
  studentId   String          @map("student_id") @db.VarChar(17)
  status      AdmissionStatus @default(HELD)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  confirmedAt DateTime?       @map("confirmed_at") @db.Timestamptz(3)

  class AdmissionClass @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([classId, status, expiresAt], map: "admission_holds_class_id_status_expires_at_idx")
  @@index([studentId], map: "admission_holds_student_id_idx")
  @@index([status, expiresAt], map: "admission_holds_status_expires_at_idx")
  @@map("admission_holds")
}

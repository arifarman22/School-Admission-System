NODE_ENV=development

HOST=127.0.0.1
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=verify-full

INTERNAL_API_KEY=change-me-to-a-long-random-string

LOG_LEVEL=info

